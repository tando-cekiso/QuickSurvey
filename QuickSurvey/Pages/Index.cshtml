@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="sidebar">
                <ul class="list-group">
                    <li class="list-group-item active">ID & Location</li>
                    <li class="list-group-item">Basic Details</li>
                    <li class="list-group-item">Notes</li>
                </ul>
            </div>
        </div>

        <div class="modal" id="addlocationModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Select Medium</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label for="locationSelect" class="form-label">Select Medium:</label>
                        <select id="locationSelect" class="form-select">
                            <option value="">Please select</option>
                            <option value="Default Medium">Default Medium</option>
                            <option value="Colour Litograph">Colour Litograph</option>
                            <option value="Etching">Etching</option>
                            <option value="Oil on canvas">Oil on canvas</option>
                    
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="saveLocation">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Section -->
        <div class="col-md-9">
            <div class="form-section">

                <div id="location-info-form" class="form-step">
                    <h2>ID & Location</h2>
                    <form id="init-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-2">
                                    <label for="locationvar" class="form-label">
                                        Location
                                        <span>
                                            <button type="button" id="add-new" class="btn btn-link btn-primary">+Add new</button>
                                        </span>
                                    </label>
                                    <select class="form-control" id="locationvar">
                                        <option>Screen Print</option>
                                        <option>Oil on board</option>
                                        <option>Charcoal</option>
                                      
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label for="accessionID" class="form-label">Accession ID</label>
                                    <input type="text" class="form-control" id="productName" />
                                </div>

                                <div class="mb-2">
                                    <label for="quantity" class="form-label">Barcode Number</label>
                                    <input type="number" class="form-control" id="quantity" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-2" id="price">
                                    <label for="price" class="form-label">Inventory ID</label>
                                    <input type="number" class="form-control" id="price" />
                                </div>

                                <div class="mb-2" id="deliveryDate">
                                    <label for="deliveryDate" class="form-label">Partner ID</label>
                                    <input type="number" class="form-control" id="deliveryDate" />
                                </div>

                                <div class="mb-3">
                                    <label for="feedback" class="form-label">Active RFID Tag Number</label>
                                    <input type="number" class="form-control" id="feedback" />
                                </div>
                            </div>
                        </div>

                        <div class="row justify-content-between align-items-center">
                            <div class="col-auto">
                                <button type="button" class="btn btn-secondary" id="previousButton">Previous</button>
                            </div>
                            <div class="col text-center">
                                <button type="button" class="btn btn-secondary" id="cancelButton">Cancel</button>
                                <button type="button" class="btn btn-primary" id="saveButton">Save</button>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary next-step">Next</button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Contact Info Form -->
                <div id="contact-info-form" class="form-step" style="display: none;">
                    <h2>Contact Information</h2>
                    <form id="contact-form">
                        <div class="mb-2">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" required />
                        </div>
                        <div class="mb-2">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" required />
                        </div>
                        <div class="mb-2">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="phone" required />
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="js/scripts.js"></script>
